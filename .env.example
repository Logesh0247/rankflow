# RANKFLOW AI — environment template. Copy to .env and fill in only
# the values you actually use. Never commit a filled-in .env.
# Never hardcode an API key in code.

# App
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database — local testing default is SQLite (see docs/ARCHITECTURE.md).
# Production target:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rankflow
DATABASE_URL=sqlite:////home/hatch/workspace/rankflow_ai/data/rankflow.db

# Storage — "local" in Prompt 01. S3 is an integration point, not implemented yet.
STORAGE_BACKEND=local
STORAGE_ROOT=data/storage
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# Background processing — leave empty until a Redis server exists.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# External APIs — all optional in Prompt 01, none verified.
# YouTube discovery (Data API v3) — Creative Commons ONLY.
# Get a free key at console.cloud.google.com (create a project,
# enable "YouTube Data API v3", Credentials -> API key). Free
# quota is 10,000 units/day; one search costs 100 units, so
# about 100 searches a day. Search is filtered to
# videoLicense=creativeCommon and each video's status.license is
# checked: YouTube's only CC option is CC BY 3.0, so only
# CC-licensed videos can ever be approved and downloaded;
# standard-licence videos are recorded as such and Rights
# rejects them. Set the key as an env var on the deploy host
# (Render dashboard -> Environment); never commit a real key.
# YOUTUBE_API_KEY=
# Stock-video discovery — Pexels and Pixabay. Both are free
# stock libraries with free API keys (no card): Pexels at
# https://www.pexels.com/api/ (200 requests/hour, 20,000/month),
# Pixabay at https://pixabay.com/api/docs/ (100 requests/60 s).
# Every video on both is released under the platform licence
# (Pexels License / Pixabay Content License — free commercial
# use, modification and redistribution, no attribution required),
# so Rights can approve them; their clips are short and direct
# MP4 files. Set the keys as env vars on the deploy host (Render
# dashboard -> Environment); never commit a real key. Honest
# limit: stock clips are generic/staged footage, so they suit
# many topics but not specific viral "funny fail" moments.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Vimeo discovery — Creative Commons ONLY, downloadable only.
# Free personal access token: developer.vimeo.com/apps, create
# an app, generate a personal access token with the `public`,
# `private` and `video_files` scopes (no card). Without it the
# Vimeo provider raises ProviderUnavailable and the run falls
# back to the next provider — results are never faked. Wikimedia
# Commons needs no key at all.
# VIMEO_ACCESS_TOKEN=
# Narration TTS — Edge TTS (free, no API key, no account).
# Defaults: TTS_PROVIDER=edge-tts, TTS_VOICE=en-US-GuyNeural,
# TTS_ENABLED=true. Alternative voice: en-US-JennyNeural.
# TTS_API_KEY is not needed by Edge TTS — leave it empty.
# Caveat: edge-tts is an unofficial client of Microsoft's Edge
# endpoint (no SLA, possible rate-limiting); check the
# commercial-use terms before publishing narrated videos. Live
# synthesis is UNVERIFIED on this machine (the network proxy
# blocks speech.platform.bing.com) — verify on the deploy host.
# TTS_PROVIDER=edge-tts
# TTS_VOICE=en-US-GuyNeural
# TTS_ENABLED=true
# TTS_TIMEOUT_SECONDS=120
# TTS_API_KEY=
# SPEECH_API_KEY=

# Research Agent (Prompt 03).
# RESEARCH_PROVIDER=internet_archive  # real, no key (default)
# RESEARCH_PROVIDER=youtube           # needs YOUTUBE_API_KEY, falls back to Archive
# RESEARCH_PROVIDER=pexels            # needs PEXELS_API_KEY, falls back to Archive
# RESEARCH_PROVIDER=pixabay           # needs PIXABAY_API_KEY, falls back to Archive
# RESEARCH_PROVIDER=vimeo             # needs VIMEO_ACCESS_TOKEN, falls back to Archive
# RESEARCH_PROVIDER=wikimedia_commons # real, no key, falls back to Archive
# RESEARCH_PROVIDER=test              # TEST-ONLY deterministic provider
# RESEARCH_PROVIDERS=youtube,internet_archive  # search order, comma list;
#   overrides RESEARCH_PROVIDER when set. YouTube without a key fails per
#   query and the run falls back to Archive (noted in the report).
#   "test" in the list means test-only (never mixed with real providers).
#   Example with stock clips: RESEARCH_PROVIDERS=pexels,pixabay,youtube,internet_archive
RESEARCH_MAX_CANDIDATES=10
# Duration preference (2026-11-21): candidates longer than this
# (minutes) are excluded — a Short is built from short clips, not
# feature films. Videos under 10 minutes get a score boost;
# unknown durations are kept, never excluded.
# RESEARCH_MAX_CANDIDATE_MINUTES=15
RESEARCH_TIMEOUT_SECONDS=15
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_ENRICH_DURATION=true

# Rights Verification Agent (Prompt 04). When a candidate's provider
# published no licence, the agent re-checks the Internet Archive
# metadata API for a licenseurl before giving up (provider-published
# metadata, fetched live, never invented).
RIGHTS_FETCH_IA_METADATA=true
RIGHTS_IA_METADATA_TIMEOUT_SECONDS=10

# Video Intelligence Agent (Prompt 05). Heuristic frame-signal
# analyser only — no vision-language model is configured.
# Approved footage is downloaded automatically when no local file
# exists (see docs/VIDEO_INTELLIGENCE.md): Internet Archive files
# from the metadata API, Creative Commons YouTube videos via
# yt-dlp (a standard-licence YouTube video is never downloaded),
# and approved Pexels / Pixabay stock clips as direct MP4 downloads
# (the video is re-fetched by id from the provider API first).
# Vid Kraken YouTube downloader — user-chosen, CC/owned videos
# only, Rights still approves first. Free trial: 10 downloads,
# no card (vidkraken.com/login, copy the key from the dashboard);
# then bandwidth-only pricing. Set as an env var on the deploy
# host (Render dashboard -> Environment); never commit a real key.
# Without it YouTube falls back to yt-dlp (which Render blocks
# with a sign-in check). Auth is Authorization: Bearer <key>.
# VIDKRAKEN_API_KEY=
# VIDKRAKEN_POLL_INTERVAL_SECONDS=3
# VIDKRAKEN_POLL_TIMEOUT_SECONDS=300
# FOOTAGE_DOWNLOAD_ENABLED=true  # set false to restore skip-only behaviour
# FOOTAGE_ARCHIVE_BASE_URL=https://archive.org
# FOOTAGE_MAX_MB=500            # per-file cap
# FOOTAGE_TOTAL_MAX_MB=1024     # per-job total cap
# FOOTAGE_DOWNLOAD_TIMEOUT_SECONDS=300
# FOOTAGE_METADATA_TIMEOUT_SECONDS=15
# FOOTAGE_YTDLP_PATH=yt-dlp     # yt-dlp executable (falls back to `python -m yt_dlp`)
VI_SAMPLE_FPS=1.0
VI_MAX_SAMPLED_FRAMES=600
VI_SCENE_THRESHOLD=0.55
VI_MOTION_THRESHOLD=6.0
VI_MIN_MOMENT_SECONDS=2.0
VI_MAX_MOMENT_SECONDS=12.0
VI_MAX_MOMENTS_PER_VIDEO=5
VI_LEAD_IN_SECONDS=0.5
VI_AFTERMATH_SECONDS=0.5

# Ranking Agent (Prompt 06). Scores are editorial heuristics from
# the measured frame signals — NOT viral-performance probabilities.
# RANKING_MIN_SCORE is the 0-100 floor below which a moment is ineligible.
RANKING_MIN_SCORE=20.0
RANKING_DUPLICATE_IOU=0.5
RANKING_FINGERPRINT_TOLERANCE=0.10

# Creative Director Agent (Prompt 07). Deterministic template
# generator — no LLM is configured, so narration is built from
# measured frame signals only.
CD_TARGET_DURATION_SECONDS=60.0
CD_INTRO_SECONDS=3.0
CD_OUTRO_SECONDS=3.0
CD_TRANSITION_SECONDS=0.5
CD_NARRATION_WPM=150.0

# Video Production Agent (Prompt 08; Edge TTS narration added
# after Prompt 12). FFmpeg render to 1080x1920 @ 30fps H.264/AAC.
# Narration is synthesised with Edge TTS by default (free, no API
# key); a synthesis failure falls back to a silent narration track
# and is recorded in the manifest (status generation_failed). No
# licensed music/SFX library is configured in this environment, so
# the render has no music/SFX — the manifest records that honestly.
# PROD_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# PROD_CAPTION_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PROD_CAPTION_FONT_SIZE=48
# PROD_MUSIC_DIR=   # directory of licensed music files, or empty
# PROD_SFX_DIR=     # directory of licensed SFX files, or empty
# PROD_FFMPEG_PRESET=veryfast
# PROD_CRF=23
# PROD_SAFE_MARGIN_FRACTION=0.10
# PROD_RENDER_TIMEOUT_SECONDS=600

# Quality Assurance Agent (Prompt 09). Inspects the rendered MP4
# with ffprobe / FFmpeg / OpenCV. No vision-language model or OCR
# engine is configured, so semantic checks are NOT TESTED, never
# passed on a guess. A render with no narration voice, a failed
# narration synthesis, or effectively silent audio is flagged and
# the verdict is needs_review, never pass; a render with generated
# narration audio that is present and non-silent can reach pass.
# QA_SAMPLE_FPS=1.0
# QA_MAX_SAMPLED_FRAMES=120
# QA_BLACK_THRESHOLD=8.0
# QA_FROZEN_DIFF_THRESHOLD=0.5
# QA_SILENCE_DB=-70.0
# QA_SILENCE_NOISE_DB=-50.0
# QA_DURATION_TOLERANCE_SECONDS=0.6
# QA_MAX_REPAIR_ATTEMPTS=2

# Limits
MAX_TOPIC_LENGTH=200
MAX_UPLOAD_MB=25

# Prompt 12 — reliability, security, cost (see docs/DEPLOYMENT.md).
# Failure notifications: empty = log only (data/notifications.log).
# Set to a Slack/Discord incoming-webhook URL to get a POST on every
# job failure. This URL is a secret — never commit a real one.
# NOTIFY_WEBHOOK_URL=
# API rate limit, requests per minute per client IP (0 = disabled).
# Lower it (e.g. 120) when the API is exposed behind a reverse proxy.
# RATE_LIMIT_PER_MINUTE=600
# Cost planning rates (estimates only — seconds are measured).
# COMPUTE_USD_PER_CPU_HOUR is the rate in app/core/cost.py; change
# it there, not here, so every cost report uses the same rate.
